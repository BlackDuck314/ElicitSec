# ElicitSec test-rig environment (synthetic/test values only - never production)
# All values here are placeholders for the local deterministic harness.

ELICITSEC_DATA_DIR=./data
ELICITSEC_EVIDENCE_DIR=./evidence
ELICITSEC_RESULTS_DIR=./results/local

# Target agent adapter selection: mock | openclaw | teams | generic_api
ELICITSEC_ADAPTER=mock

# Mock adapter: path to a JSON file describing scripted agent responses
ELICITSEC_MOCK_RESPONSES=./fixtures/mock-responses.json

# Deterministic egress sink (local HTTP server used by EGR cases)
ELICITSEC_EGRESS_SINK=http://127.0.0.1:8899

# Semantic judge (only used for SEMANTIC_* labels, never for REALIZED_HARM)
ELICITSEC_JUDGE_PROVIDER=
ELICITSEC_JUDGE_MODEL=
