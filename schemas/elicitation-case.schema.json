{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CentaurMews/ElicitSec/schemas/elicitation-case.schema.json",
  "title": "ElicitationCase",
  "description": "A versioned security-elicitation experiment (methodology section 7.3).",
  "type": "object",
  "required": ["id","version","title","status","constructs","consequence_tier",
               "actors","adversarial_condition","protected_invariants","utility_control","run_policy"],
  "properties": {
    "id": {"type":"string","pattern":"^[A-Z]+-\d{3}$"},
    "version": {"type":"string","pattern":"^\d+\.\d+\.\d+$"},
    "title": {"type":"string","minLength":5},
    "status": {"type":"string","enum":["canonical","candidate","quarantined","retired"]},
    "methodology_version": {"type":"string"},
    "description": {"type":"string"},
    "constructs": {
      "type":"array","minItems":1,
      "items":{"type":"string","pattern":"^(OBJ|CTX|CAP|STATE|CHAIN|DATA)-\d{2}$"}
    },
    "assessment_modes": {
      "type":"array","minItems":1,"items":{"type":"string","enum":["black_box","grey_box","white_box"]}
    },
    "severity_if_realized": {"type":"string","enum":["low","medium","high","critical"]},
    "consequence_tier": {"type":"integer","minimum":0,"maximum":5},
    "preconditions": {"type":"array","items":{"type":"string"}},
    "actors": {
      "type":"object",
      "required":["attacker","agent_identity"],
      "properties": {
        "attacker":{"type":"string"},
        "authorized_user":{"type":"string"},
        "agent_identity":{"type":"string"},
        "additional":{"type":"object"}
      }
    },
    "legitimate_task": {
      "type":"object","required":["message"],
      "properties": {
        "channel":{"type":"string"},
        "message":{"type":"string"},
        "attachments":{"type":"array"}
      }
    },
    "adversarial_condition": {
      "type":"object","required":["type","message"],
      "properties": {
        "type":{"type":"string","enum":["direct_request","retrieved_content","tool_return","email","memory_seed","multi_turn"]},
        "message":{"type":"string"},
        "turns":{"type":"array","items":{"type":"string"}},
        "source_fixture":{"type":"string"}
      }
    },
    "protected_invariants": {"type":"array","minItems":1,"items":{"type":"string"}},
    "semantic_failure_conditions": {"type":"array","items":{"type":"string"}},
    "tool_failure_conditions": {"type":"array","items":{"type":"string"}},
    "realized_harm_oracles": {
      "type":"array",
      "items":{
        "type":"object","required":["type","fail_if"],
        "properties":{
          "type":{"type":"string","enum":["retrieval_audit","output_marker","metadata_leakage","secret_detection",
                                          "tool_call","authorization","file_state","memory_state",
                                          "azure_activity","keyvault_diagnostic","egress_sink","utility_result"]},
          "target":{"type":"string"},
          "fail_if":{"type":"string"}
        }
      }
    },
    "utility_control": {
      "type":"object","required":["message","expected"],
      "properties":{
        "actor":{"type":"string"},
        "channel":{"type":"string"},
        "message":{"type":"string"},
        "attachments":{"type":"array"},
        "expected":{"type":"string"}
      }
    },
    "fixtures": {"type":"array","items":{"type":"string"}},
    "safe_targets": {"type":"array","items":{"type":"string"}},
    "run_policy": {
      "type":"object",
      "properties":{
        "repetitions":{"type":"integer","minimum":1,"default":1},
        "temperatures":{"type":"array","items":{"type":"number"}},
        "capture":{"type":"array","items":{"type":"string"}},
        "requires_snapshot":{"type":"boolean"},
        "cleanup":{"type":"array","items":{"type":"string"}}
      }
    }
  }
}
