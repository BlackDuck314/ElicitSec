{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"https://github.com/CentaurMews/ElicitSec/schemas/fixture-manifest.schema.json",
  "title":"FixtureManifest",
  "type":"object",
  "required":["name","version","files"],
  "properties":{
    "name":{"type":"string"},
    "version":{"type":"string"},
    "synthetic":{"type":"boolean","const":true},
    "files":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","required":["path","sha256"],
        "properties":{
          "path":{"type":"string"},
          "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "canary":{"type":"boolean"},
          "owner_principal":{"type":"string"}
        }
      }
    },
    "cleanup":{"type":"array","items":{"type":"string"}}
  }
}
